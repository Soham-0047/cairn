# Public — exposed to browser
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Canonical public origin, no trailing slash. Drives canonical URLs, sitemap,
# robots.txt and OG tags. In production: https://cairn.sohamdev.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console HTML-tag verification token (the content="..." value).
# Optional — the meta tag is omitted entirely when unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# NextAuth — must be the exact public origin. In production:
# NEXTAUTH_URL=https://cairn.sohamdev.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# GitHub OAuth — create at https://github.com/settings/developers
# Authorization callback URL (local): http://localhost:3000/api/auth/callback/github
# Authorization callback URL (prod):  https://cairn.sohamdev.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod):  https://cairn.sohamdev.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT secret — MUST match the backend's JWT_SECRET (used to mint user tokens)
BACKEND_JWT_SECRET=replace-me-with-a-long-random-string
BACKEND_JWT_ISSUER=cairn

# Admin token — MUST match the backend's ADMIN_SECRET
ADMIN_SECRET=replace-me-with-a-long-random-string
